source_hpp %{
#include "gc/shenandoah/shenandoahBarrierSetAssembler.hpp"
#include "gc/shenandoah/c2/shenandoahSupport.hpp"
%}

instruct compareAndSwapP_shenandoah(rRegI result,
                                    indirect mem,
                                    rax_RegP oldval, rRegP newval,
                                    rRegL tmp,
                                    rFlagsReg cr)
%{
  match(Set result (CompareAndSwapP mem (Binary oldval newval)));
  predicate(UseShenandoahGC && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP_DEF tmp, TEMP_DEF result, KILL cr, KILL oldval);

  format %{ "cmpxchg_shenandoah $mem, $oldval, $newval\t# (ptr) if $mem == $oldval then $mem <-- $newval" %}

  ins_encode %{
    ShenandoahBarrierSet::assembler()->cmpxchg_oop_c2(this, masm,
                                                      $mem$$base$$Register, $oldval$$Register, $newval$$Register, $result$$Register, $tmp$$Register,
                                                      /*acquire*/ false, /*release*/ true, /*weak*/ false, /*is_cae*/ false);

  %}
  ins_pipe( pipe_cmpxchg );
%}

instruct weakCompareAndSwapP_shenandoah(rRegI result,
                                        indirect mem,
                                        rax_RegP oldval, rRegP newval,
                                        rRegL tmp,
                                        rFlagsReg cr)
%{
  match(Set result (WeakCompareAndSwapP mem (Binary oldval newval)));
  predicate(UseShenandoahGC && n->as_LoadStore()->barrier_data() != 0);
  effect(TEMP_DEF tmp, TEMP_DEF result, KILL cr, KILL oldval);

  format %{ "cmpxchg_shenandoah $result = $mem, $oldval, $newval\t# (ptr, weak) if $mem == $oldval then $mem <-- $newval" %}

  ins_encode %{
    ShenandoahBarrierSet::assembler()->cmpxchg_oop_c2(this, masm,
                                                      $mem$$base$$Register, $oldval$$Register, $newval$$Register, $result$$Register, $tmp$$Register,
                                                      /*acquire*/ false, /*release*/ true, /*weak*/ true, /*is_cae*/ false);
  %}
  ins_pipe( pipe_cmpxchg );
%}

